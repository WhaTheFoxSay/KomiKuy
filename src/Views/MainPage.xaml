<Page
    x:Class="Mangaplus.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mangaplus.Views"
    xmlns:models="using:Mangaplus.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0F1117">

    <Page.Resources>
        <Storyboard x:Name="SplashFadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="ExtendedSplashPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="*" />    <!-- Main Content Pivot -->
            <RowDefinition Height="Auto" /> <!-- Loading / Status Bar -->
        </Grid.RowDefinitions>

        <!-- Full-screen User Water Ripples Wallpaper for Menu Utama -->
        <Image Source="ms-appx:///Assets/SplashBackground.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Grid.RowSpan="3" />

        <!-- Deep emerald glass vignette so comic cards and typography have pristine contrast -->
        <Border Background="#CC09120C"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Grid.RowSpan="3" />

        <!-- Compact Top Header Bar with Glass Background -->
        <Border Grid.Row="0" Background="#CC10151C" BorderBrush="#33262A36" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- KomiKuy! Single Unified Aesthetic Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#1E1B4B" BorderBrush="#7C3AED" BorderThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/AppLogo.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KomiKuy!" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FFFFFF" Margin="0,0,0,-2" />
                        <TextBlock Text="PORTAL BACA KOMIK" FontSize="7.5" FontWeight="Bold" Foreground="#38BDF8" />
                    </StackPanel>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="1" Click="BtnRefresh_Click" Background="Transparent" BorderThickness="0" Padding="6,2" MinWidth="0" MinHeight="0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF" />
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Pivot -->
        <Pivot x:Name="MainPivot" Grid.Row="1" SelectionChanged="MainPivot_SelectionChanged">
            
            <!-- 1. Hot Rankings Tab (Uniform Compact Metro) -->
            <PivotItem Header="POPULER">
                <Grid>
                    <ListView x:Name="ListRankings"
                              ItemClick="MangaItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="6,2">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="3" BorderBrush="#262A36" BorderThickness="1" Height="82" Padding="6,5" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- Rank Badge -->
                                            <ColumnDefinition Width="56" />   <!-- Cover Thumbnail -->
                                            <ColumnDefinition Width="*" />    <!-- Info -->
                                            <ColumnDefinition Width="Auto" /> <!-- Action BACA -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Rank Number -->
                                        <Border Grid.Column="0" Width="24" Height="24" Background="#2563EB" CornerRadius="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Ranking}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Cover Thumbnail -->
                                        <Border Grid.Column="1" CornerRadius="2" Background="#101218" Width="56" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding PortraitImageUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Title & Info -->
                                        <StackPanel Grid.Column="2" Margin="8,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            
                                            <TextBlock Text="{Binding LatestChapterName}" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            
                                            <!-- Detail Waktu Update / Viewers -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBlock Text="{Binding DisplayUpdateInfo}" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                            </StackPanel>

                                            <!-- Badges -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="#332563EB" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding DisplayType}" FontSize="7.5" Foreground="#60A5FA" FontWeight="Bold" />
                                                </Border>
                                                <Border Background="#2210B981" CornerRadius="2" Padding="4,1">
                                                    <TextBlock Text="POPULER" FontSize="7.5" Foreground="#34D399" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <Border Grid.Column="3" Background="#2563EB" CornerRadius="2" Width="44" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="BACA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- 2. Lanjutkan (Garis Baca / Bookmark) Tab -->
            <PivotItem Header="LANJUTKAN">
                <Grid>
                    <TextBlock x:Name="TxtNoBookmarks"
                               Text="Belum ada komik dengan garis baca.&#x0a;Saat membaca bab, ketuk 'Garis Baca' lalu klik halaman yang ingin Anda tandai!"
                               FontSize="11" Foreground="#8E95A5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Visibility="Collapsed" />
                    
                    <ListView x:Name="ListBookmarks"
                              ItemClick="BookmarkItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="6,2">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="3" BorderBrush="#DC2626" BorderThickness="1" Margin="0,2" Padding="6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Cover -->
                                        <Border Grid.Column="0" CornerRadius="2" Background="#101218" Width="48" Height="64">
                                            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Title & Bookmark info -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TitleName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ChapterName}" FontSize="9.5" Foreground="#60A5FA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                            
                                            <Border Background="#4C991B1B" HorizontalAlignment="Left" CornerRadius="2" Padding="5,1.5" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding DisplayPage}" FontSize="8.5" FontWeight="Bold" Foreground="#FCA5A5" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Continue Button -->
                                        <Border Grid.Column="2" Background="#DC2626" CornerRadius="2" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="BACA" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- 3. Latest Updates Tab (1 Komik per Baris - Compact Metro) -->
            <PivotItem Header="TERBARU">
                <Grid>
                    <ListView x:Name="ListLatest"
                              ItemClick="MangaItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="6,2">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="3" BorderBrush="#262A36" BorderThickness="1" Height="82" Padding="6,5" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />   <!-- Cover Thumbnail -->
                                            <ColumnDefinition Width="*" />    <!-- Info details -->
                                            <ColumnDefinition Width="Auto" /> <!-- Read Action -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover Thumbnail -->
                                        <Border Grid.Column="0" CornerRadius="2" Background="#101218" Width="56" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding PortraitImageUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Info (Title, Chapter, Waktu Update, Badges) -->
                                        <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            
                                            <TextBlock Text="{Binding LatestChapterName}" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            
                                            <!-- Detail Waktu Update -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBlock Text="{Binding DisplayUpdateInfo}" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                            </StackPanel>

                                            <!-- Comic Type & Ongoing Badge -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="#332563EB" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding DisplayType}" FontSize="7.5" Foreground="#60A5FA" FontWeight="Bold" />
                                                </Border>
                                                <Border Background="#2210B981" CornerRadius="2" Padding="4,1">
                                                    <TextBlock Text="ONGOING" FontSize="7.5" Foreground="#34D399" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <Border Grid.Column="2" Background="#2563EB" CornerRadius="2" Width="44" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="BACA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- 4. Manga Tab (3 Komik per Baris) -->
            <PivotItem Header="MANGA">
                <Grid>
                    <GridView x:Name="GridManga"
                              ItemClick="MangaItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="2,2">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="104" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="1" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="2" BorderBrush="#262A36" BorderThickness="1" Width="100" Height="162" Padding="3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="114" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="2" Background="#101218">
                                            <Image Source="{Binding PortraitImageUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{Binding LatestChapterName}" FontSize="8" Foreground="#60A5FA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </PivotItem>

            <!-- 5. Manhwa Tab (3 Komik per Baris) -->
            <PivotItem Header="MANHWA">
                <Grid>
                    <GridView x:Name="GridManhwa"
                              ItemClick="MangaItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="2,2">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="104" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="1" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="2" BorderBrush="#262A36" BorderThickness="1" Width="100" Height="162" Padding="3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="114" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="2" Background="#101218">
                                            <Image Source="{Binding PortraitImageUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{Binding LatestChapterName}" FontSize="8" Foreground="#60A5FA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </PivotItem>

            <!-- 6. Manhua Tab (3 Komik per Baris) -->
            <PivotItem Header="MANHUA">
                <Grid>
                    <GridView x:Name="GridManhua"
                              ItemClick="MangaItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="2,2">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="104" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="1" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="2" BorderBrush="#262A36" BorderThickness="1" Width="100" Height="162" Padding="3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="114" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="2" Background="#101218">
                                            <Image Source="{Binding PortraitImageUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{Binding LatestChapterName}" FontSize="8" Foreground="#60A5FA" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </PivotItem>

            <!-- 6. Genre Tab -->
            <PivotItem Header="GENRE">
                <Grid>
                    <!-- State A: Grid of Metro Genre Tiles -->
                    <Grid x:Name="PanelGenreSelector" Visibility="Visible">
                        <GridView x:Name="GridGenres"
                                  ItemClick="GenreTile_Click"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                  ShowsScrollingPlaceholders="False"
                                  Padding="6,4">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="152" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="3" Height="50" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Accent indicator -->
                                            <Border Grid.Column="0" Background="{Binding BadgeColor}" CornerRadius="1" Margin="0,2,0,2" />
                                            
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" FontSize="8" Foreground="#8E95A5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <!-- State B: Comics in Selected Genre -->
                    <Grid x:Name="PanelGenreComics" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar with Back Button -->
                        <Grid Grid.Row="0" Background="#141720" BorderBrush="#262A36" BorderThickness="0,0,0,1" Padding="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Click="BtnBackToGenres_Click" Background="#262A36" Foreground="#FFFFFF" Padding="8,4" MinWidth="0" MinHeight="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Semua Genre" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="TxtCurrentGenreHeader" Grid.Column="1" Text="GENRE: AKSI" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        </Grid>

                        <ProgressBar x:Name="BarGenreLoading" Grid.Row="0" IsIndeterminate="True" Height="2" Foreground="#2563EB" Background="Transparent" Visibility="Collapsed" VerticalAlignment="Bottom" />

                        <!-- Comics in Genre (Exact same uniform, compact Metro card) -->
                        <ListView x:Name="ListGenreComics"
                                  Grid.Row="1"
                                  ItemClick="MangaItem_Click"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                  ShowsScrollingPlaceholders="False"
                                  Padding="6,2">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#181B24" CornerRadius="3" BorderBrush="#262A36" BorderThickness="1" Height="82" Padding="6,5" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Cover Thumbnail -->
                                            <Border Grid.Column="0" CornerRadius="2" Background="#101218" Width="56" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding PortraitImageUrl}" Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Info (Title, Chapter, Waktu Update, Badges) -->
                                            <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                
                                                <TextBlock Text="{Binding LatestChapterName}" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                    <TextBlock Text="{Binding DisplayUpdateInfo}" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Border Background="#332563EB" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding DisplayType}" FontSize="7.5" Foreground="#60A5FA" FontWeight="Bold" />
                                                    </Border>
                                                    <Border Background="#2210B981" CornerRadius="2" Padding="4,1">
                                                        <TextBlock Text="KOMIK" FontSize="7.5" Foreground="#34D399" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Button -->
                                            <Border Grid.Column="2" Background="#2563EB" CornerRadius="2" Width="44" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="BACA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- 7. Search Tab (Compact Metro) -->
            <PivotItem Header="CARI">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,4,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Grid.Column="0" PlaceholderText="Cari judul komik..." TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown" Background="#181B24" Foreground="#FFFFFF" BorderBrush="#262A36" />
                        <Button Grid.Column="1" Click="BtnDoSearch_Click" Background="#2563EB" Foreground="#FFFFFF" Margin="6,0,0,0" Padding="12,6">
                            <TextBlock Text="CARI" FontSize="10" FontWeight="Bold" />
                        </Button>
                    </Grid>

                    <ListView x:Name="ListSearchResults"
                              Grid.Row="1"
                              ItemClick="MangaItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="6,2">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="3" BorderBrush="#262A36" BorderThickness="1" Height="82" Padding="6,5" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />   <!-- Cover Thumbnail -->
                                            <ColumnDefinition Width="*" />    <!-- Info details -->
                                            <ColumnDefinition Width="Auto" /> <!-- Read Action -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover Thumbnail -->
                                        <Border Grid.Column="0" CornerRadius="2" Background="#101218" Width="56" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding PortraitImageUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Info (Title, Chapter, Waktu Update, Badges) -->
                                        <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            
                                            <TextBlock Text="{Binding LatestChapterName}" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            
                                            <!-- Detail Waktu Update / Genre -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBlock Text="{Binding DisplayUpdateInfo}" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                            </StackPanel>

                                            <!-- Comic Type & Ongoing Badge -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="#332563EB" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding DisplayType}" FontSize="7.5" Foreground="#60A5FA" FontWeight="Bold" />
                                                </Border>
                                                <Border Background="#2210B981" CornerRadius="2" Padding="4,1">
                                                    <TextBlock Text="KOMIK" FontSize="7.5" Foreground="#34D399" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <Border Grid.Column="2" Background="#2563EB" CornerRadius="2" Width="44" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="BACA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- 7. Favorites Tab -->
            <PivotItem Header="FAVORIT">
                <Grid>
                    <TextBlock x:Name="TxtNoFavorites" Text="Belum ada komik favorit.&#x0a;Buka manga lalu ketuk tombol favorit untuk menyimpannya di sini!" FontSize="11" Foreground="#8E95A5" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
                    
                    <ListView x:Name="ListFavorites"
                              ItemClick="MangaItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="6,2">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="3" BorderBrush="#262A36" BorderThickness="1" Margin="0,2" Padding="6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="2" Background="#101218" Width="52" Height="72">
                                            <Image Source="{Binding PortraitImageUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                            <Border Background="#332563EB" HorizontalAlignment="Left" CornerRadius="2" Padding="4,1" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DisplayType}" FontSize="8" Foreground="#60A5FA" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- 8. History Tab -->
            <PivotItem Header="RIWAYAT">
                <Grid>
                    <TextBlock x:Name="TxtNoHistory" Text="Belum ada riwayat membaca.&#x0a;Mulai baca komik favoritmu sekarang!" FontSize="11" Foreground="#8E95A5" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
                    
                    <ListView x:Name="ListHistory"
                              ItemClick="HistoryItem_Click"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ShowsScrollingPlaceholders="False"
                              Padding="6,2">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181B24" CornerRadius="3" BorderBrush="#262A36" BorderThickness="1" Margin="0,2" Padding="6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="2" Background="#101218" Width="45" Height="60">
                                            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TitleName}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ChapterName}" FontSize="9.5" Foreground="#60A5FA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimeAgoString}" FontSize="8.5" Foreground="#8E95A5" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#2563EB" CornerRadius="2" Padding="6,3" VerticalAlignment="Center">
                                            <TextBlock Text="BACA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- Compact Status Bottom Bar -->
        <Border Grid.Row="2" Background="#181B24" BorderBrush="#262A36" BorderThickness="0,1,0,0" Padding="10,3">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="KomiKuy! • Siap Membaca" FontSize="9" Foreground="#8E95A5" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtTotalCount" Text="" FontSize="9" Foreground="#8E95A5" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Full-Portrait Seamless Extended Splash Screen with User's Green Water Ripples Photo -->
        <Grid x:Name="ExtendedSplashPanel"
              Background="#144E13"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="3"
              Canvas.ZIndex="100"
              Visibility="Visible">

            <!-- Full-screen portrait water ripples wallpaper -->
            <Image Source="ms-appx:///Assets/SplashBackground.jpg"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />

            <!-- Soft vignette shade so branding and status are crystal clear -->
            <Border Background="#4D000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- High-Res Transparent Floating Emblem & Typography -->
                    <Image Source="ms-appx:///Assets/SplashPortrait.png"
                           Width="310"
                           Height="450"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                    <!-- Native Progress Ring & Live Status Text -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,8">
                        <ProgressRing x:Name="SplashRing"
                                      IsActive="True"
                                      Width="18"
                                      Height="18"
                                      Foreground="#34D399"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtSplashStatus"
                                   Text="Menghubungkan ke KomiKuy!..."
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#F1F5F9"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Text="KomiKuy! Mobile • Windows 10 Mobile"
                       FontSize="9"
                       Foreground="#CBD5E1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,16" />
        </Grid>
    </Grid>
</Page>
