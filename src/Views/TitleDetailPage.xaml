<Page
    x:Class="Mangaplus.Views.TitleDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mangaplus.Views"
    xmlns:models="using:Mangaplus.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0F1117">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="Auto" /> <!-- Inline Slim Progress Bar -->
            <RowDefinition Height="*" />    <!-- Virtualized ListView with Header -->
        </Grid.RowDefinitions>

        <!-- Background Wallpaper -->
        <Image Source="ms-appx:///Assets/SplashBackground.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Grid.RowSpan="3" />
        <Border Background="#E608100C"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Grid.RowSpan="3" />

        <!-- Windows Phone Metro Top Header Bar -->
        <Border Grid.Row="0" Background="#181B24" BorderBrush="#262A36" BorderThickness="0,0,0,1" Padding="8,4" Canvas.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Padding="6,2" MinWidth="0" MinHeight="0">
                    <TextBlock Text="←" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                </Button>

                <!-- Title Header Text -->
                <TextBlock x:Name="TxtHeaderTitle" Grid.Column="1" Text="DETAIL KOMIK" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />

                <!-- Favorite Button -->
                <Button x:Name="BtnFavorite" Grid.Column="2" Click="BtnFavorite_Click" Background="Transparent" BorderThickness="0" Padding="6,2" MinWidth="0" MinHeight="0">
                    <TextBlock x:Name="TxtFavIcon" Text="☆" FontSize="18" FontWeight="Bold" Foreground="#FBBF24" />
                </Button>
            </Grid>
        </Border>

        <!-- Inline Non-blocking Progress Bar -->
        <ProgressBar x:Name="BarLoading" Grid.Row="1" IsIndeterminate="True" Height="2.5" Foreground="#2563EB" Background="Transparent" Visibility="Collapsed" Canvas.ZIndex="15" />

        <!-- FULLY VIRTUALIZED CHAPTER LIST (100% 60 FPS smoothly handles 1,200+ chapters) -->
        <ListView x:Name="ListChapters"
                  Grid.Row="2"
                  ItemClick="ChapterItem_Click"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ShowsScrollingPlaceholders="False">
            
            <ListView.Header>
                <StackPanel Padding="8,6">
                    
                    <!-- Manga Info Card -->
                    <Grid Margin="0,0,0,8" Background="#181B24" Padding="8" CornerRadius="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Uncropped Full Cover Image -->
                        <Border Grid.Column="0" Background="#101218" Width="105" MaxHeight="155" VerticalAlignment="Top" CornerRadius="2">
                            <Image x:Name="ImgCover" Stretch="Uniform" VerticalAlignment="Top" />
                        </Border>

                        <!-- Info Details Table -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                            <TextBlock x:Name="TxtTitleName" Text="Judul Komik" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FFFFFF" TextWrapping="Wrap" MaxLines="2" />
                            
                            <TextBlock x:Name="TxtAltName" Text="" FontSize="9.5" Foreground="#8E95A5" Margin="0,1,0,3" TextWrapping="Wrap" MaxLines="2" Visibility="Collapsed" />
                            
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Penulis:" FontSize="9.5" Foreground="#8E95A5" />
                                <TextBlock x:Name="TxtAuthor" Grid.Column="1" Text="-" FontSize="9.5" FontWeight="SemiBold" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Margin="0,1,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tipe / Status:" FontSize="9.5" Foreground="#8E95A5" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#2563EB" Padding="4,0" Margin="0,0,4,0" CornerRadius="2">
                                        <TextBlock x:Name="TxtComicType" Text="Manga" FontSize="8.5" Foreground="#FFFFFF" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#22FFFFFF" Padding="4,0" CornerRadius="2">
                                        <TextBlock x:Name="TxtStatusBadge" Text="Ongoing" FontSize="8.5" Foreground="#8E95A5" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="RowRating" Margin="0,1,0,2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rating / Usia:" FontSize="9.5" Foreground="#8E95A5" />
                                <TextBlock x:Name="TxtRating" Grid.Column="1" Text="15+" FontSize="9.5" Foreground="#FBBF24" FontWeight="SemiBold" />
                            </Grid>

                            <Grid x:Name="RowViews" Margin="0,1,0,2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pembaca:" FontSize="9.5" Foreground="#8E95A5" />
                                <TextBlock x:Name="TxtViews" Grid.Column="1" Text="" FontSize="9" Foreground="#8E95A5" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Last Update for Ongoing Manga -->
                            <Grid x:Name="RowLastUpdate" Margin="0,1,0,2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Update:" FontSize="9.5" Foreground="#8E95A5" />
                                <TextBlock x:Name="TxtLastUpdate" Grid.Column="1" Text="-" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Quick Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="BtnFirstChapter" Click="BtnFirstChapter_Click" Background="#2563EB" Foreground="#FFFFFF" Padding="8,3" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0" MinWidth="0" MinHeight="0">
                                    <TextBlock Text="Bab Awal" FontSize="9.5" />
                                </Button>
                                <Button x:Name="BtnLatestChapter" Click="BtnLatestChapter_Click" Background="#262A36" Foreground="#FFFFFF" Padding="8,3" FontSize="10" FontWeight="SemiBold" MinWidth="0" MinHeight="0">
                                    <TextBlock Text="Bab Terbaru" FontSize="9.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Genre Tags Section -->
                    <Border x:Name="PanelGenres" Background="#181B24" Padding="8,6" Margin="0,0,0,8" CornerRadius="2" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="GENRE" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#60A5FA" Margin="0,0,0,4" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ListGenreChips" Orientation="Horizontal">
                                    <!-- Dynamic Genre pills -->
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Synopsis Section -->
                    <Border Background="#181B24" Padding="8" Margin="0,0,0,8" CornerRadius="2">
                        <StackPanel>
                            <TextBlock Text="SINOPSIS" FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#60A5FA" Margin="0,0,0,3" />
                            <TextBlock x:Name="TxtSynopsis"
                                       Text="Memuat sinopsis komik..."
                                       FontSize="10"
                                       Foreground="#D1D5DB"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="BtnToggleSynopsis"
                                    Click="BtnToggleSynopsis_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0,4,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TxtToggleSynopsis"
                                           Text="Buka sinopsis lengkap ▼"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="#38BDF8" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- CHAPTERS SECTION HEADER -->
                    <Grid Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DAFTAR CHAPTER" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="TxtTotalChapters" Text="" FontSize="9.5" Foreground="#8E95A5" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Click="BtnSortChapters_Click" Background="Transparent" BorderThickness="0" Padding="4,2" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtSortIcon" Text="⇅ Urutan" FontSize="10.5" FontWeight="SemiBold" Foreground="#8E95A5" />
                        </Button>
                    </Grid>

                    <!-- CHAPTER SEARCH BOX -->
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearchChapter"
                                 Grid.Column="0"
                                 PlaceholderText="Cari nomor chapter (contoh: 120)..."
                                 InputScope="Number"
                                 TextChanged="TxtSearchChapter_TextChanged"
                                 Background="#181B24"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#262A36"
                                 FontSize="11"
                                 Padding="6,4" />
                        <Button Grid.Column="1"
                                x:Name="BtnClearChapterSearch"
                                Click="BtnClearChapterSearch_Click"
                                Background="#262A36"
                                Foreground="#94A3B8"
                                Margin="4,0,0,0"
                                Padding="8,4"
                                Visibility="Collapsed">
                            <TextBlock Text="✕" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- DYNAMIC RANGE TAGS -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                        <StackPanel x:Name="PanelRangeTags" Orientation="Horizontal">
                            <!-- Dynamic 50-step range tags -->
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </ListView.Header>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="64" ItemHeight="40" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E2330" BorderBrush="#2E384D" BorderThickness="1" CornerRadius="3" Width="64" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayShortName}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Resume History Prompt Modal Overlay (Solid background: details are completely hidden until user chooses) -->
        <Grid x:Name="PanelResumeModal" Grid.RowSpan="3" Background="#FF0B0E14" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="50">
            <!-- Header bar for modal with back button -->
            <Grid VerticalAlignment="Top" Height="42" Padding="8,4">
                <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Padding="6,2" MinWidth="0" MinHeight="0">
                    <TextBlock Text="←" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                </Button>
            </Grid>

            <Border Background="#181B24" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="4" Width="285" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="RIWAYAT BACA" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock x:Name="TxtResumePromptTitle" Text="Lanjut Membaca?" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtResumePromptChapter" Text="Bab sebelumnya: Chapter 120" FontSize="10.5" Foreground="#E0E0E0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Button Lihat Komik -->
                        <Button x:Name="BtnDismissResume" Click="BtnDismissResume_Click" Grid.Column="0" Background="#262A36" Foreground="#FFFFFF" Padding="6,8" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="Lihat Komik" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Button>
                        
                        <!-- Button Lanjut Membaca -->
                        <Button x:Name="BtnConfirmResume" Click="BtnConfirmResume_Click" Grid.Column="1" Background="#2563EB" Foreground="#FFFFFF" Padding="6,8" Margin="4,0,0,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="Lanjut Membaca" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
